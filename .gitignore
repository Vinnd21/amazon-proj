### Node ###
# Dependency directories
node_modules/

# Optional npm cache directory
.npm/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
/pids
/*.pid
/*.seed
/*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/

# nyc coverage
.nyc_output/

# TypeScript cache
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env
.env.*.local

# Mac
.DS_Store

# Windows
Thumbs.db
